# .gitignore

# Ignore virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.pyc

# Plot images (generated analysis output; portfolio images live in docs/images/)
*.png
!docs/images/*.png

# OS files
.DS_Store

# Jupyter checkpoints (if any)
.ipynb_checkpoints/

ml_datasets/*.parquet

# ML training artifacts (models, scalers, scored datasets) - regenerate via ml/train.py
ml_outputs/
*.keras
*.joblib

# pytest
.pytest_cache/


# Generated outputs (too large for GitHub)
ml_outputs_*/
polarization_plots_reco/
polariztion_plots_new/
